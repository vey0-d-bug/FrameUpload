#!/bin/bash
# Stand-in for SteamOS's steamos-add-to-steam: records the file it was given
# in $FAKE_STATE/added-to-steam.txt. Switch: $FAKE_STATE/add-fails makes it
# fail the way a broken add would.
if [ -e "$FAKE_STATE/add-fails" ]; then
  echo 'steamos-add-to-steam: could not reach Steam' >&2
  exit 1
fi
[ -e "$1" ] || { echo "steamos-add-to-steam: $1: no such file" >&2; exit 2; }
printf '%s\n' "$1" >> "$FAKE_STATE/added-to-steam.txt"
